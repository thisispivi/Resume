{
  "name": "resume",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "homepage": "https://resume.pivi.dev",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "audit": "pnpm audit --audit-level=moderate",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "preview": "vite preview",
    "selfcheck": "node src/utils/dates.selfcheck.ts",
    "prepare": "cd .. & husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "peers": "pnpm peers check",
    "update:packages": "npx npm-check-updates -u --reject @eslint/js,eslint,typescript"
  },
  "lint-staged": {
    "*.js": "pnpm run lint",
    "*.{js,css,md,html,json}": "pnpm run format"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "i18next": "^27.0.1",
    "jspdf": "^4.2.1",
    "react": "^19.3.1",
    "react-avatar-editor": "^16.0.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-svgr": "^5.2.0"
  }
}
