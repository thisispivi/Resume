{
  "name": "resume",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://resume.pivi.dev",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "preview": "vite preview",
    "prepare": "cd .. & husky",
    "format": "prettier . --write",
    "predeploygh": "pnpm run build",
    "deploygh": "npx gh-pages -d dist",
    "update:packages": "ncu -u --reject @eslint/js,eslint"
  },
  "lint-staged": {
    "*.js": "pnpm run lint",
    "*.{js,css,md,html,json}": "pnpm run format"
  },
  "browserslist": {
    "production": [
      ">0.01%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      ">0.01%",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.5",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.3.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  }
}
